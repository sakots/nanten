# 本番ビルド用のSSH鍵パス。秘密鍵の内容は書かないでください。
# build/allowed_signers に対応する公開鍵の登録が必要です。
# agent利用時は対応する .pub のパスも指定できます。
NANTEN_BUILD_SSH_KEY=~/.ssh/id_ed25519

# 公開ディレクトリの絶対URL（例: https://example.com/nanten/）
# .env.local にコピーして実際のURLを設定してください。
# 空欄ならOGP・Twitterカード用メタタグとcanonicalを生成しません。
SITE_URL=

# 広告ありAndroidリリース版用。デバッグ版は必ずGoogleのテストIDを使用します。
# IDはAdMob管理画面で取得します。秘密鍵ではありません。
NANTEN_ADMOB_APP_ID=
NANTEN_ADMOB_BANNER_ID=
NANTEN_ADMOB_INTERSTITIAL_ID=

# Google Play向けAABの署名用。SSHビルド鍵とは別です。
# 本物の値は .env.local またはCIのシークレットにだけ設定してください。
NANTEN_ANDROID_KEYSTORE=
NANTEN_ANDROID_STORE_PASSWORD=
NANTEN_ANDROID_KEY_ALIAS=
NANTEN_ANDROID_KEY_PASSWORD=
