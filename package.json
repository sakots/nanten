{
  "name": "nanten",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:android:ads": "tsc -b && vite build --mode android-ads",
    "build:android:adfree": "tsc -b && vite build --mode android-adfree",
    "android:ads": "node scripts/build-android.mjs ads",
    "android:adfree": "node scripts/build-android.mjs adfree",
    "android:ads:release": "node scripts/build-android.mjs ads release",
    "android:adfree:release": "node scripts/build-android.mjs adfree release",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.0",
    "workbox-window": "^7.4.1"
  }
}
